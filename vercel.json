{
  "routes": [
    {
      "src": "^/$",
      "has": [{ "type": "query", "key": "lang", "value": "en" }],
      "dest": "/index-en.html"
    },
    {
      "src": "^/$",
      "has": [{ "type": "query", "key": "lang", "value": "pt" }],
      "dest": "/index-pt.html"
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
